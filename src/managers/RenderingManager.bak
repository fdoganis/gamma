import {
  Scene,
  PerspectiveCamera,
  WebGLRenderer,
  AmbientLight,
  HemisphereLight,
  CylinderGeometry,
  MeshPhongMaterial,
  InstancedMesh,
  Vector3,
  Quaternion,
  Matrix4,
  BufferGeometry,
  Color
} from 'three';

import {
  OrbitControls
} from 'three/addons/controls/OrbitControls.js';

import { XRButton } from 'three/addons/webxr/XRButton.js';

import { XRMode } from '../core/XRMode';

export class RenderingManager {
  renderer: WebGLRenderer = new WebGLRenderer({ antialias: true, alpha: true });
  scene: Scene = new Scene();
  camera: PerspectiveCamera = new PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 10);

  controls?: OrbitControls;

  xrmode: Symbol = XRMode.NONE;
  #XRInputSourcesChangeListenerRef?: any; // TODO: CHECK: is there any better solution than any?

  // TODO: ARCHI: move elsewhere : Game World? Command? EntityManager?

  //
  #material: MeshPhongMaterial = new MeshPhongMaterial({ color: 0xffffff });
  #MAX_TARGETS: number = 1024;
  #instancedMesh?: InstancedMesh;

  // CONST
  #_ONE: Vector3 = new Vector3(1, 1, 1);
  #_mat4: Matrix4 = new Matrix4();
  //

  #initGeometry(geometry: BufferGeometry) {

    if (this.#instancedMesh) { return; }

    // Set up all instances with random matrices
    this.#instancedMesh = new InstancedMesh(geometry, this.#material, this.#MAX_TARGETS);
    const matrix = new Matrix4();
    const color = new Color();

    for (let i = 0; i < this.#MAX_TARGETS; i++) {

      this.#instancedMesh.setMatrixAt(i, matrix);
      this.#instancedMesh.setColorAt(i, color.setHex(Math.random() * 0xffffff));

    }

    // I'd like to set the number of instaces to zero but this seems to be problematic.
    // If I do so I can't change the count later on
    // Hack: setting hack to a small float value like 0.1 works, but seems fragile.
    // Bypass: set count to 1 + invisible then set flag to visible. Semantically makes sense.
    this.#instancedMesh.count = 1;
    this.#instancedMesh.visible = false;

    this.#instancedMesh.instanceMatrix.needsUpdate = true;
    if (this.#instancedMesh.instanceColor) {
      this.#instancedMesh.instanceColor.needsUpdate = true;
    }


    this.scene.add(this.#instancedMesh);

    //this.#instancedMesh.count = 0;

  }

  spawnAt(geometry: BufferGeometry, position: Vector3, orientation: Quaternion): void {

    this.#initGeometry(geometry);
    if (!this.#instancedMesh) { return; }

    if (this.#instancedMesh.count === 1 && this.#instancedMesh.visible === false) {
      this.#instancedMesh.visible = true;
    } else if (this.#instancedMesh.count < this.#MAX_TARGETS) {
      this.#instancedMesh.count++;
    }

    this.#_mat4.compose(position, orientation, this.#_ONE);
    this.#instancedMesh.setMatrixAt(this.#instancedMesh.count - 1, this.#_mat4); // instancedMesh reange ; [0, count]

    this.#instancedMesh.instanceMatrix.needsUpdate = true;
    if (this.#instancedMesh.instanceColor) {
      this.#instancedMesh.instanceColor.needsUpdate = true;
    }
  }

  //

  constructor() {
    this.#initRenderer();
    this.#initXRButton();
    this.#initLights();
    this.#initScene();
    this.#initXRSession();

    window.addEventListener('resize', this.#onResize);
    const xr = this.renderer.xr
    xr.addEventListener('sessionstart', this.#onXRStart)
    xr.addEventListener('sessionend', this.#onXREnd)
  }

  #initRenderer() {
    this.renderer.setPixelRatio(window.devicePixelRatio);
    this.renderer.setSize(window.innerWidth, window.innerHeight);
    this.renderer.xr.enabled = true;

    document.body.appendChild(this.renderer.domElement);
  }

  #initXRButton() {
    const sessionInit = {
      'optionalFeatures': ['hand-tracking']
    }

    // {
    //   'optionalFeatures': [ 'depth-sensing' ],
    //   'depthSensing': { 'usagePreference': [ 'gpu-optimized' ], 'dataFormatPreference': [] }
    // } 

    const btn = XRButton.createButton(this.renderer, sessionInit);
    btn.style.backgroundColor = 'skyblue';
    document.body.appendChild(btn);
  }

  #initXRSession() {
    const xr = this.renderer.xr
    xr.addEventListener('sessionstart', this.#onXRStart)
    xr.addEventListener('sessionend', this.#onXREnd)
  }


  #initLights() {
    const hemi = new HemisphereLight(0xffffff, 0xbbbbff, 3);
    hemi.position.set(0.5, 1, 0.25);
    this.scene.add(new AmbientLight(0xffffff, 1.0));
    this.scene.add(hemi);
  }

  #initScene() {
    this.#onResize();
    this.#initLights();

    this.camera.position.set(0, 1.6, 3); // Useless in XR: your head / mobile device drives the camera

    //this.#initGeometry();

    this.controls = new OrbitControls(this.camera, this.renderer.domElement);
    this.controls.target.set(0, 1.6, 0);
    this.controls.update();
  }

  render() {
    this.renderer.render(this.scene, this.camera);
  }

  #onResize = () => {
    // Don't resize while in XR
    if (this.renderer.xr?.isPresenting) { return; }

    this.camera.aspect = window.innerWidth / window.innerHeight;
    this.camera.updateProjectionMatrix();
    this.renderer.setSize(window.innerWidth, window.innerHeight);
  };

  #onXRStart = () => {
    if (this.controls) this.controls.enabled = false;

    const session = this.renderer.xr.getSession();
    if (session) {

      // TODO: OPTIONAL
      // Detect which kind of session and device we are dealing with (see XRMode)
      // More exhaustive XR device detection here : 
      // https://github.com/aframevr/aframe/blob/master/src/utils/device.js
      this.#XRInputSourcesChangeListenerRef = this.#createXRInputSourcesChangeListener(session);

      session.addEventListener('inputsourceschange', this.#XRInputSourcesChangeListenerRef);

      if (session.environmentBlendMode !== 'opaque') {
        this.xrmode = XRMode.AR;
      }
      else {
        this.xrmode = XRMode.VR;
      }
    }
  }

  //this.input.enterXR(}}
  #onXREnd = () => { if (this.controls) this.controls.enabled = true; }

  #createXRInputSourcesChangeListener = (session: XRSession) => (e: XRInputSourcesChangeEvent) => {
    if ([...session.inputSources].length === 1
      && [...session.inputSources][0].targetRayMode === 'screen') {
      this.xrmode = XRMode.MOBILE_AR;

      // TODO: It seems, in emulators at least, that every tap triggers an 'inputsourcechange' event with 'added'
      // Once a XRMode has been defined it should stay the same until the end of the session,
      // i.e.: until 'sessionsend' has been called.
    };
  }

  dispose() {
    const xr = this.renderer.xr;
    xr.removeEventListener('sessionstart', this.#onXRStart);
    xr.removeEventListener('sessionend', this.#onXREnd);

    const session = xr.getSession();
    session?.removeEventListener('inputsourceschange', this.#XRInputSourcesChangeListenerRef);
    window.removeEventListener('resize', this.#onResize);
    this.controls?.dispose();
    this.renderer.dispose();
  }
}